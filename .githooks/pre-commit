#!/bin/sh
# ============================================================
# pre-commit: چک همگام‌سازی نسخه‌ها و مستندات
# سامانه‌ی مدیریت تجهیزات و قطعات یدکی — طراح: میثم ایجادی / Meysam Ijadi
# ----------------------------------------------------------------
# تضمین می‌کند README، DOCKER_HUB_OVERVIEW و ورژن‌ها با هم هماهنگ بمانند.
# فعال‌سازی یک‌باره پس از clone (محلی):
#   git config core.hooksPath .githooks
# رد شدن موقت برای کامیت‌های بی‌ربط:  git commit --no-verify
# ============================================================
node scripts/check-docs-sync.mjs || {
  echo ""
  echo "pre-commit: کامیت لغو شد — ناهمگونی‌های بالا را اصلاح کنید"
  echo "           (یا برای کامیت بی‌ربط به مستندات: git commit --no-verify)"
  exit 1
}
