# ============================================================
# نمونه‌ی متغیرهای محیطی — سامانه‌ی مدیریت تجهیزات و قطعات یدکی
# طراح: میثم ایجادی / Meysam Ijadi — M.Ijadi@Hotmail.com
# استفاده: این فایل را به .env کپی کنید (cp .env.example .env) و مقادیر را ویرایش کنید.
# نکته: مقادیر کاربران فقط در راه‌اندازی اولیه (دیتابیس خالی) اعمال می‌شوند.
# ============================================================

# --- شبکه ---
APP_PORT=4000

# --- احراز هویت ---
# حتماً در تولید به رشته‌ی طولانی تصادفی تغییر دهید: openssl rand -hex 32
JWT_SECRET=please-change-this-secret-in-production-9f2a4c7e1b8d
JWT_EXPIRES_HOURS=12

# --- کاربران پیش‌فرض (فقط در راه‌اندازی اولیه) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123
WAREHOUSE_USERNAME=warehouse
WAREHOUSE_PASSWORD=warehouse123
SALES_USERNAME=sales
SALES_PASSWORD=sales123
TECH_USERNAME=tech
TECH_PASSWORD=tech123

# --- لایسنس / طرح (نسخه‌ی فعلی: رایگان — محدودسازی فقط با فلگ‌های زیر) ---
# 1 = اعمال انقضای لایسنس (بلاک شدن سامانه پس از پایان اعتبار)؛ 0 = فقط هشدار
LICENSE_ENFORCE=0
# سقف تعداد تجهیزات در طرح آزمایشی (trial)
TRIAL_DEVICE_LIMIT=25
# 1 = بلاک افزودن تجهیز/سریال پس از رسیدن به سقف آزمایشی (خطای ۴۰۲ + پیام ارتقا)؛ 0 = فقط گزارش
TRIAL_LIMIT_ENFORCE=0

# --- پشتیبان‌گیری خودکار (پیش‌فرض‌های داکر: /app/server/backups، ۳۰ نسخه، ساعت ۳) ---
# BACKUP_DIR=/app/server/backups
# BACKUP_KEEP=30
# BACKUP_AT=3
# برای push بکاپ به مقصد خارجی یا S3 به مستندات (README) مراجعه کنید.
