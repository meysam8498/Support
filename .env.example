# ─────────────────────────────────────────────────────────────
# نمونه‌ی متغیرهای محیطی برای Docker Compose.
# پلتفرم مدیریت پروژه و تجهیزات — طراح: میثم ایجادی / Meysam Ijadi
#   ایمیل: M.Ijadi@Hotmail.com — تلفن: +98 902 296 4006
#
# این فایل را به .env کپی کرده و مقادیر را مطابق نیاز تنظیم کنید.
# (دقت کنید: فایل .env هرگز در گیت commit نمی‌شود.)
# ─────────────────────────────────────────────────────────────

# پورت بیرونی که کانتینر روی آن سرو می‌شود (داخل کانتینر همیشه 4000 است)
APP_PORT=4000

# کلید امضای توکن احراز هویت — در محیط تولید حتماً یک رشته‌ی
# طولانی و تصادفی (مثلاً خروجی `openssl rand -hex 32`) قرار دهید.
JWT_SECRET=please-change-this-secret-in-production-9f2a4c7e1b8d

# مدت اعتبار توکن (ساعت)
JWT_EXPIRES_HOURS=12

# کاربران پیش‌فرض (فقط در راه‌اندازی اولیه دیتابیس اعمال می‌شوند)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123
