# Dependencies
node_modules/

# Build output
server/dist/
client/dist/

# Database (local data, must not be committed)
# کل پوشه‌ی داده‌ی محلی — شامل DB واقعی و پشتیبان‌ها؛ هیچ‌چیز از server/data کامیت نمی‌شود
server/data/

# داده‌ی محلیِ ریشه — سرورِ اجراشده از ریشه، JWT secret را در data/jwt-secret.txt می‌سازد
# (SECRET است — نباید کامیت شود؛ قبلاً فقط server/data نادیده گرفته می‌شد)
/data/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Private signing keys (لایسنس — هرگز کامیت نشود)
keys/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript incremental build cache
tsunbuildinfo
*.tsbuildinfo

# Desktop (Tauri) build artifacts — رزورس‌ها شامل node.exe و باندل سرور است و هرگز کامیت نمی‌شود
desktop/src-tauri/target/
desktop/src-tauri/resources/
desktop/src-tauri/gen/
desktop/src-tauri/static-dist/

# Freebuff agent workspace
.freebuff/
.cloud-attachments/
