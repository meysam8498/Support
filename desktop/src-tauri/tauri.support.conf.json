{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Support Support Server",
  "version": "1.27.0",
  "identifier": "ir.ijadi.support-supportserver",
  "build": {
    "frontendDist": "static-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "languages": ["Farsi", "English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
